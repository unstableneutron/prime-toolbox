{
  "name": "prime-toolbox",
  "version": "0.1.0",
  "private": true,
  "description": "Portable skills and extensions for Prime Agent.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "prime-agent"
  ],
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "skills": [
      "./packages/prime-websearch-parallel/skills",
      "./packages/prime-fff-repo-search/skills",
      "./packages/prime-robust-read/skills",
      "./packages/prime-bg-jobs/skills"
    ],
    "extensions": [
      "./packages/prime-subagent-fast-mode/extensions/subagent-fast-mode/index.js",
      "./packages/prime-ipython-yield/extensions/ipython-yield/index.js"
    ]
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check --workspaces --if-present"
  }
}
